generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  category    Category
  imageUrl    String?
  sizes       ProductSize[] @relation("ProductToSizes")
  cartItems   CartItem[]    @relation("ProductToCartItems")
  orderItems  OrderItem[]   @relation("ProductToOrderItems")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum Category {
  WHOLE
  GROUND
  COMBO
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  product   Product @relation("ProductToSizes", fields: [productId], references: [id])
  productId Int
  size      String // e.g., "100g", "200g"
  price     Decimal @db.Decimal(10, 2)
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(COD)
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PaymentMethod {
  COD // Cash on Delivery
  ONLINE // placeholder for future gateways
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation("ProductToOrderItems", fields: [productId], references: [id])
  productId Int
  size      String // size chosen at purchase
  price     Decimal @db.Decimal(10, 2) // snapshot of price at order time
  quantity  Int     @default(1)
}

model CartItem {
  id           Int     @id @default(autoincrement())
  user         User    @relation(fields: [userId], references: [id])
  userId       Int
  product      Product @relation("ProductToCartItems", fields: [productId], references: [id])
  productId    Int
  productName  String?
  productImage String?
  size         String
  quantity     Int     @default(1)
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  username  String?
  phone     String?
  role      String? // 'user' or 'admin'
  orders    Order[]
  cartItems CartItem[]
}
